{
  "name": "esports-isolator-pro-ui",
  "version": "1.1.1",
  "private": true,
  "description": "Electron shell for Esports Isolator PRO.",
  "author": "Esports Isolator PRO",
  "main": "electron-main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev-runner.js",
    "dev:renderer": "node scripts/dev-runner.js --renderer-only",
    "preview:test": "vite preview --host 127.0.0.1",
    "smoke": "node scripts/smoke-test.js",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test:unit": "node --test tests/*.test.mjs",
    "build:renderer": "vite build",
    "build:assets": "node scripts/generate-assets.js",
    "build:backend-manifest": "node scripts/generate-backend-manifest.js",
    "build:python-runtime": "node scripts/prepare-python-runtime.js",
    "verify:packaged-runtime": "node scripts/verify-packaged-runtime.js",
    "verify:installed-artifacts": "node scripts/verify-installed-artifacts.js",
    "clean:packaged": "node scripts/clean-packaged-output.js",
    "test:visual": "playwright test --config playwright.config.js tests/visual",
    "test:a11y": "playwright test --config playwright.config.js tests/a11y",
    "test:ui-quality": "npm run build:renderer && npm run test:visual && npm run test:a11y",
    "pack": "npm run clean:packaged && npm run build:renderer && npm run build:assets && npm run build:backend-manifest && npm run build:python-runtime && electron-builder --dir && node scripts/harden-packaged-backend-acl.js dist-packaged/win-unpacked",
    "build": "npm run clean:packaged && npm run build:renderer && npm run build:assets && npm run build:backend-manifest && npm run build:python-runtime && electron-builder --win nsis && node scripts/harden-packaged-backend-acl.js dist-packaged/win-unpacked"
  },
  "dependencies": {
    "@carbon/icons-react": "11.80.0",
    "@carbon/react": "1.107.1",
    "@vitejs/plugin-react": "6.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.0",
    "electron": "42.2.0",
    "electron-builder": "26.8.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "sass": "1.99.0",
    "stylelint": "17.14.1"
  },
  "build": {
    "appId": "com.esportsisolator.pro",
    "productName": "Esports Isolator PRO",
    "asar": true,
    "afterPack": "scripts/harden-packaged-backend-acl.js",
    "electronVersion": "42.2.0",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist-packaged"
    },
    "files": [
      "electron-main.js",
      "backend-runtime.js",
      "backend-manifest.json",
      "electron-preload.js",
      "shared/**/*",
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "backend/server"
      },
      {
        "from": "../isolator",
        "to": "backend/isolator"
      },
      {
        "from": "../best_isolator.py",
        "to": "backend/best_isolator.py"
      },
      {
        "from": "../config.json.example",
        "to": "backend/config.json.example"
      },
      {
        "from": "../requirements.txt",
        "to": "backend/requirements.txt"
      },
      {
        "from": ".runtime/python",
        "to": "python"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  }
}
